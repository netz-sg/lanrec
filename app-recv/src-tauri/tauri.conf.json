{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanrec receiver",
  "version": "0.3.0",
  "identifier": "world.lifad.lanrec.recv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lanrec receiver",
        "width": 720,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
